# API service
NODE_ENV=production
PORT=8080
API_BASE_URL=https://api.videosaverpro.online
CORS_ORIGIN=https://www.videosaverpro.online

# Data stores
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/videosaverpro
REDIS_URL=redis://HOST:6379
JOB_QUEUE_NAME=video_jobs

# Storage
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace_me
R2_SECRET_ACCESS_KEY=replace_me
R2_BUCKET=videosaverpro-downloads
SIGNED_URL_TTL_SECONDS=3600

# Security
JWT_SECRET=replace_me
API_KEY_SALT=replace_me
REQUEST_TIMEOUT_MS=10000
MAX_URL_LENGTH=2048
REQUESTS_PER_MINUTE=240
INSPECT_CACHE_TTL_SECONDS=300
REQUIRE_API_KEY=false
SERVICE_API_KEY=
WORKER_CONCURRENCY=50
SIGNED_URL_SECRET=replace_me

# Optional integrations
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# Existing upstream key if used as fallback adapter
RAPIDAPI_KEY=

# Cloudflare gateway worker vars
API_ORIGIN=https://your-api-service.example.com
GATEWAY_RPM=240
